# PostgreSQL connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/primewave_resource_manager"

# Optional. Direct (non-pooled) connection used by Prisma Migrate. Only needed when
# DATABASE_URL points at a connection pooler (e.g. a Neon "-pooler" host).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
